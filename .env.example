# Foundry Local OpenAI-compatible endpoint (use the active port shown by Foundry)
FOUNDRY_BASE_URL=http://127.0.0.1:64414/v1
FOUNDRY_API_KEY=local

# Exact model IDs returned by GET /v1/models
FOUNDRY_MODEL_PHI=phi-4-mini
FOUNDRY_MODEL_QWEN=qwen3-vl-4b-instruct-generic-cpu

# NinjaOne MCP Streamable HTTP endpoint
MCP_URL=http://127.0.0.1:8000/mcp

HOST=127.0.0.1
PORT=8080
MODEL_TIMEOUT=180
MAX_HISTORY_MESSAGES=6
MAX_STORED_MESSAGES=24
AGENT_RECURSION_LIMIT=6

# Report storage and scheduled report email delivery (optional)
# Reports are saved under ./reports and downloadable from the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
