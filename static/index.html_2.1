<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>NinjaOne Reporting & Operations Assistant</title>
<style>
:root{color-scheme:dark;--bg:#101319;--panel:#191e27;--line:#303846;--text:#e9edf4;--muted:#9aa6b5;--accent:#78a9ff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,Segoe UI,Arial}header{padding:16px 22px;border-bottom:1px solid var(--line);display:flex;gap:12px;align-items:center;justify-content:space-between}h1{font-size:18px;margin:0}main{max-width:1100px;margin:auto;padding:18px;display:grid;grid-template-columns:minmax(0,2fr) minmax(260px,1fr);gap:16px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden}.panel h2{font-size:14px;margin:0;padding:12px 14px;border-bottom:1px solid var(--line);color:#cbd5e1}.chat{min-height:65vh;display:flex;flex-direction:column}.messages{padding:14px;display:flex;flex-direction:column;gap:12px;flex:1;overflow:auto;max-height:65vh}.bubble{white-space:pre-wrap;overflow-wrap:anywhere;padding:12px 14px;border-radius:10px;max-width:100%}.user{background:#263750;align-self:flex-end;max-width:90%}.agent{background:#202630;align-self:stretch}.composer{border-top:1px solid var(--line);padding:12px;display:flex;gap:8px}.composer textarea{resize:vertical;min-height:54px;max-height:180px;flex:1;background:#11161d;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:10px;font:inherit}.composer button,select,.secondary{background:#263750;color:var(--text);border:1px solid #3c526f;border-radius:8px;padding:9px 12px;cursor:pointer}.controls{display:flex;gap:8px;align-items:center}.muted{color:var(--muted);font-size:12px}.activity{padding:12px;max-height:65vh;overflow:auto}.event{border:1px solid var(--line);border-radius:8px;margin-bottom:9px;padding:9px}.event summary{cursor:pointer;color:#c6d5ea;font-size:13px}.event pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;color:#b9c3d1}.status{font-size:12px;color:var(--muted)}@media(max-width:800px){main{grid-template-columns:1fr}.chat{min-height:55vh}}
</style></head>
<body>
<header><div><h1>NinjaOne Reporting & Operations Assistant</h1><div class="muted">V2 · Live NinjaOne MCP · Foundry Local · Reports & schedules</div></div><div class="controls"><select id="model"><option value="phi">Phi model</option><option value="qwen">Qwen vision model</option></select><button class="secondary" id="clear">New chat</button></div></header>
<main><section class="panel chat"><h2>Chat</h2><div style="padding:10px 12px;display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--line)"><button class="secondary" id="makeReport" type="button">Export latest answer</button><select id="reportFormats"><option value="xlsx,pdf">Excel + PDF</option><option value="csv">CSV</option><option value="xlsx">Excel</option><option value="pdf">PDF</option><option value="csv,xlsx,pdf">All formats</option></select></div><div id="messages" class="messages"><div class="bubble agent">Ask a NinjaOne question. The agent can select and call available MCP tools, including multi-step lookups.</div></div><form id="form" class="composer"><textarea id="prompt" placeholder="Ask about users, devices, organizations, alerts, or reports…" required></textarea><button id="send">Send</button></form></section>
<section class="panel"><h2>Tool activity</h2><div id="activity" class="activity"><div class="muted">Tool calls and results appear here.</div></div><h2>Connection</h2><div id="status" class="activity muted">Checking…</div><h2>Scheduled reports</h2><div class="activity"><input id="schedName" placeholder="Schedule name" style="width:100%;margin-bottom:6px;padding:8px"><textarea id="schedPrompt" placeholder="Report query/prompt" style="width:100%;min-height:70px;margin-bottom:6px;padding:8px"></textarea><input id="schedCron" value="0 9 * * 1" title="Cron: minute hour day month weekday" style="width:100%;margin-bottom:6px;padding:8px"><input id="schedEmail" placeholder="Optional email recipient (SMTP required)" style="width:100%;margin-bottom:6px;padding:8px"><button class="secondary" id="createSchedule" type="button">Create weekly schedule</button><div id="scheduleList" class="muted" style="margin-top:8px"></div></div><h2>Available tools</h2><div id="tools" class="activity muted">Loading…</div></section></main>
<script>
const $=id=>document.getElementById(id);let sessionId=null;let latestAnswer='';const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function bubble(text,role){const d=document.createElement('div');d.className='bubble '+role;d.textContent=text;$('messages').appendChild(d);$('messages').scrollTop=$('messages').scrollHeight;return d}
function showActivity(items){$('activity').innerHTML='';if(!items?.length){$('activity').innerHTML='<div class="muted">No MCP tool calls in this response.</div>';return}for(const e of items){const d=document.createElement('details');d.className='event';const title=(e.kind==='call'?'CALL ':'RESULT ')+(e.tool||'tool');d.innerHTML=`<summary>${esc(title)}</summary><pre>${esc(e.kind==='call'?JSON.stringify(e.arguments||{},null,2):(e.result||''))}</pre>`;$('activity').appendChild(d)}}

async function refreshSchedules(){try{const d=await fetch('/api/reports/schedules').then(r=>r.json());$('scheduleList').innerHTML=(d.schedules||[]).map(s=>`<div class="event"><b>${esc(s.name)}</b><div class="muted">${esc(s.cron)} · ${esc(s.timezone)} · ${s.enabled?'enabled':'paused'} · ${esc(s.last_status||'not run')}</div><button class="secondary" onclick="toggleSchedule('${esc(s.id)}',${s.enabled?0:1})">${s.enabled?'Pause':'Resume'}</button><button class="secondary" onclick="deleteSchedule('${esc(s.id)}')">Delete</button></div>`).join('')||'No schedules yet.'}catch(e){$('scheduleList').textContent='Schedule API unavailable'}}
window.toggleSchedule=async(id,en)=>{await fetch(`/api/reports/schedules/${id}/toggle?enabled=${!!en}`,{method:'POST'});refreshSchedules()}
window.deleteSchedule=async(id)=>{await fetch(`/api/reports/schedules/${id}`,{method:'DELETE'});refreshSchedules()}
$('makeReport').addEventListener('click',async()=>{if(!latestAnswer){alert('Ask the agent first, then export its latest answer.');return}const formats=$('reportFormats').value.split(',');try{const r=await fetch('/api/reports/generate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:'NinjaOne Report',content:latestAnswer,formats,metadata:{source:'Latest agent response'}})});const d=await r.json();if(!r.ok)throw new Error(d.detail||'Report generation failed');const box=document.createElement('div');box.className='bubble agent';box.innerHTML='Reports ready: '+d.files.map(f=>`<a href="${esc(f.url)}" target="_blank">${esc(f.filename)}</a>`).join(' · ');$('messages').appendChild(box)}catch(e){alert(e.message)}});
$('createSchedule').addEventListener('click',async()=>{const body={name:$('schedName').value||'Weekly NinjaOne report',prompt:$('schedPrompt').value,formats:['xlsx','pdf'],cron:$('schedCron').value,timezone:'Asia/Kolkata',email_to:$('schedEmail').value};if(!body.prompt){alert('Enter the report prompt.');return}try{const r=await fetch('/api/reports/schedules',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const d=await r.json();if(!r.ok)throw new Error(d.detail||'Could not create schedule');alert('Schedule created. Next run: '+d.next_run);refreshSchedules()}catch(e){alert(e.message)}});
async function load(){try{const [h,t]=await Promise.all([fetch('/api/health').then(r=>r.json()),fetch('/api/tools').then(r=>r.json())]);$('status').textContent=`Foundry: ${h.foundry_base_url}\nMCP: ${h.mcp_url}\nTools loaded: ${t.tools.length}`;$('tools').innerHTML=t.tools.map(x=>`<div class="event"><b>${esc(x.name)}</b><div class="muted">${esc(x.description||'')}</div></div>`).join('')}catch(e){$('status').textContent='Could not connect to app/MCP: '+e}}
$('form').addEventListener('submit',async e=>{e.preventDefault();const message=$('prompt').value.trim();if(!message)return;$('prompt').value='';bubble(message,'user');const pending=bubble('Thinking and using tools as needed…','agent');$('send').disabled=true;try{const r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({session_id:sessionId,model:$('model').value,message})});const data=await r.json();if(!r.ok)throw new Error(data.detail||r.statusText);sessionId=data.session_id;pending.textContent=data.answer;latestAnswer=data.answer;showActivity(data.activity)}catch(err){pending.textContent='Error: '+err.message;showActivity([])}finally{$('send').disabled=false;$('prompt').focus()}});
$('prompt').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();$('form').requestSubmit()}});
$('clear').addEventListener('click',async()=>{if(sessionId)await fetch('/api/session/'+encodeURIComponent(sessionId),{method:'DELETE'});sessionId=null;$('messages').innerHTML='';$('activity').innerHTML='<div class="muted">Tool calls and results appear here.</div>';bubble('New session started.','agent')});load();refreshSchedules();
</script></body></html>
